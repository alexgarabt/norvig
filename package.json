{
    "name": "norvig",
    "version": "0.1.0",
    "description": "Probabilistic spell corrector based on Peter Norvig's algorithm",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
